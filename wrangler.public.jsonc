{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tenfootpole",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  // Landing page on the apex; IDE preview URLs on *.tenfootpole.dev.
  // Requires a proxied wildcard DNS record (*) for the zone.
  "routes": [
    { "pattern": "tenfootpole.dev", "custom_domain": true },
    { "pattern": "*.tenfootpole.dev/*", "zone_name": "tenfootpole.dev" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the Worker before static assets so IDE preview subdomains are
    // proxied to the sandbox instead of being served index.html for "/".
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard",
      "max_instances": 10,
      // Let live sessions finish (10 min + 2 min margin) before a deploy replaces them.
      "rollout_active_grace_period": 720
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      },
      {
        "class_name": "Registry",
        "name": "REGISTRY"
      },
      {
        "class_name": "EgressLog",
        "name": "EGRESS_LOG"
      }
    ]
  },
  "workflows": [
    {
      "name": "provision-workflow",
      "binding": "PROVISION_WORKFLOW",
      "class_name": "ProvisionWorkflow"
    }
  ],
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["Registry"],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": ["EgressLog"],
      "tag": "v3"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    // AI agent (Pi) inference. Any Workers AI id, third-party "author/model",
    // or "dynamic/<route>". Gateway "default" is auto-created.
    "AI_MODEL": "@cf/zai-org/glm-5.3-flash",
    "AI_GATEWAY_ID": "default",
    // Per-scanner time limit (seconds) for the provision-time security scan.
    "SCAN_TIMEOUT_SEC": "90",
    // Public site: hard cap of 10 concurrent sandboxes, 10-minute sessions.
    "MAX_CONTAINERS": "10",
    // Hard session length; the sandbox is destroyed when it elapses.
    "SESSION_MAX_MINUTES": "10",
    // "deny" = sandboxes have no internet (every attempt is logged and
    // blocked). "open" = HTTP(S) allowed (still logged). Needed for quick
    // tunnels and for anything that must download packages.
    "EGRESS_MODE": "deny",
    // Wildcard domain for IDE preview URLs (e.g. "example.com" with
    // *.example.com routed to this Worker). Leave empty to use quick
    // tunnels instead, which require EGRESS_MODE=open.
    "PREVIEW_HOSTNAME": "tenfootpole.dev"
  },
  "observability": {
    "enabled": true
  }
}
