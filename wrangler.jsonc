{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tenfootpole",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the Worker before static assets so IDE preview subdomains are
    // proxied to the sandbox instead of being served index.html for "/".
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 100
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      },
      {
        "class_name": "Registry",
        "name": "REGISTRY"
      }
    ]
  },
  "workflows": [
    {
      "name": "provision-workflow",
      "binding": "PROVISION_WORKFLOW",
      "class_name": "ProvisionWorkflow"
    }
  ],
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["Registry"],
      "tag": "v2"
    }
  ],
  "vars": {
    // Max sandboxes alive at once. 0 = unlimited (self-hosted default).
    "MAX_CONTAINERS": "0",
    // Hard session length; the sandbox is destroyed when it elapses.
    "SESSION_MAX_MINUTES": "60",
    // "deny" = sandboxes have no internet (every attempt is logged and
    // blocked). "open" = full network access (HTTP(S) still logged). Open is
    // the self-hosted default because quick tunnels need it; set it to
    // "deny" once PREVIEW_HOSTNAME is configured.
    "EGRESS_MODE": "open",
    // Wildcard domain for IDE preview URLs (e.g. "example.com" with
    // *.example.com routed to this Worker). Leave empty to use quick
    // tunnels instead, which require EGRESS_MODE=open.
    "PREVIEW_HOSTNAME": ""
  },
  "observability": {
    "enabled": true
  }
}
